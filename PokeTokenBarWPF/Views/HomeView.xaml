<UserControl x:Class="PokeTokenBar.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PokeTokenBar.Views"
             xmlns:core="clr-namespace:PokeTokenBar.Core">

    <UserControl.Resources>
        <SolidColorBrush x:Key="BgBrush"      Color="#1A1A2E"/>
        <SolidColorBrush x:Key="CardBrush"    Color="#16213E"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#FFD700"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="GreenBrush"   Color="#4CAF50"/>
        <SolidColorBrush x:Key="OrangeBrush"  Color="#FF9800"/>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize"   Value="10"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"   Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding"      Value="12"/>
            <Setter Property="Margin"       Value="0,4"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- ── Companion card ─────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sprite / egg display -->
                <Border Grid.Column="0"
                        Width="80" Height="80"
                        Background="#0F3460"
                        CornerRadius="8">
                    <views:SpriteView x:Name="SpriteCtrl" DataContext="{Binding}"/>
                </Border>

                <!-- Companion info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding CompanionName}"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="15" FontWeight="Bold"/>

                    <!-- Evolution / egg progress bar -->
                    <TextBlock Margin="0,4,0,2" Style="{StaticResource Label}">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Progress: {0}">
                                <Binding Path="EggProgress"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <ProgressBar Value="{Binding EggProgressValue, Mode=OneWay}"
                                 Minimum="0" Maximum="1"
                                 Height="6" Margin="0,0,0,4"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#0F3460"/>

                    <!-- Rarity / shiny badge -->
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Store.Companion.State.Active.Rarity, FallbackValue=Egg}"
                                   Foreground="{StaticResource SubtextBrush}"
                                   FontSize="10" Margin="0,0,6,0"/>
                        <TextBlock Text="✨" FontSize="10"
                                   Visibility="{Binding Store.Companion.State.Active.IsShiny,
                                       Converter={x:Static views:BoolToVisConverter.Instance}}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Today's usage card ─────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Today" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding TodayTokens}" Style="{StaticResource Value}"/>
                    <TextBlock Text="{Binding TodayCost}"
                               Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="This Week" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding WeekTokens}" Style="{StaticResource Value}"/>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="This Month" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding MonthTokens}" Style="{StaticResource Value}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Burn rate card ─────────────────────────────────────────────── -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Burn Rate" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding BurnRate}" Style="{StaticResource Value}"/>
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Wallet 💰" Style="{StaticResource Label}"/>
                    <TextBlock Text="{Binding WalletDisplay}" Style="{StaticResource Value}"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── Last updated ───────────────────────────────────────────────── -->
        <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0"
                   Foreground="{StaticResource SubtextBrush}" FontSize="9">
            <TextBlock.Text>
                <MultiBinding StringFormat="Updated: {0:HH:mm:ss}">
                    <Binding Path="Store.LastFetched"/>
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>

    </StackPanel>
</UserControl>
