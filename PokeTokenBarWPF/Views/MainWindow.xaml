<Window x:Class="PokeTokenBar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PokeTokenBar.ViewModels"
        xmlns:views="clr-namespace:PokeTokenBar.Views"
        Title="PokeTokenBar"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <!-- Outer border gives rounded corners + shadow -->
    <Border Background="{StaticResource WindowBg}"
            CornerRadius="14"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Tab pills -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Footer -->
            </Grid.RowDefinitions>

            <!-- ── Tab pills ──────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10"
                    Margin="10,10,10,4" Padding="3">
                <UniformGrid Columns="4">
                    <Button Content="Home" Command="{Binding GoHomeCommand}"
                            Style="{StaticResource TabPill}"
                            Background="{Binding CurrentTab, Converter={x:Static views:TabPillBgConverter.Instance}, ConverterParameter=Home}"
                            Foreground="{Binding CurrentTab, Converter={x:Static views:TabPillFgConverter.Instance}, ConverterParameter=Home}"/>
                    <Button Content="Dex" Command="{Binding GoPokedexCommand}"
                            Style="{StaticResource TabPill}"
                            Background="{Binding CurrentTab, Converter={x:Static views:TabPillBgConverter.Instance}, ConverterParameter=Pokedex}"
                            Foreground="{Binding CurrentTab, Converter={x:Static views:TabPillFgConverter.Instance}, ConverterParameter=Pokedex}"/>
                    <Button Content="Shop" Command="{Binding GoShopCommand}"
                            Style="{StaticResource TabPill}"
                            Background="{Binding CurrentTab, Converter={x:Static views:TabPillBgConverter.Instance}, ConverterParameter=Shop}"
                            Foreground="{Binding CurrentTab, Converter={x:Static views:TabPillFgConverter.Instance}, ConverterParameter=Shop}"/>
                    <Button Content="Settings" Command="{Binding GoSettingsCommand}"
                            Style="{StaticResource TabPill}"
                            Background="{Binding CurrentTab, Converter={x:Static views:TabPillBgConverter.Instance}, ConverterParameter=Settings}"
                            Foreground="{Binding CurrentTab, Converter={x:Static views:TabPillFgConverter.Instance}, ConverterParameter=Settings}"/>
                </UniformGrid>
            </Border>

            <!-- ── Content area ───────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <Grid Margin="14,6,14,8">

                    <!-- Home tab -->
                    <views:HomeView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Home}"
                        DataContext="{Binding}"/>

                    <!-- Pokedex tab -->
                    <views:PokedexView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Pokedex}"
                        DataContext="{Binding}"/>

                    <!-- Shop tab -->
                    <views:ShopView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Shop}"
                        DataContext="{Binding}"/>

                    <!-- Settings tab -->
                    <views:SettingsView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Settings}"
                        DataContext="{Binding}"/>
                </Grid>
            </ScrollViewer>

            <!-- ── Footer — matches the macOS "↻ Updated just now … ⚙ ⏻" strip ────── -->
            <Grid Grid.Row="2" Margin="16,2,10,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="↻" FontSize="11" Foreground="{StaticResource SubtextBrush}" Margin="0,0,4,0"/>
                    <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="10">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="Updated {0:HH:mm:ss}">
                                <Binding Path="Store.LastFetched"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Command="{Binding RefreshCommand}"
                            Style="{StaticResource IconButton}"
                            ToolTip="Refresh now">🔄</Button>
                    <Button Click="CloseButton_Click"
                            Style="{StaticResource IconButton}"
                            ToolTip="Close">✕</Button>
                </StackPanel>
            </Grid>

            <!-- ── Toast (replaces native MessageBox for confirmations) ─────── -->
            <Border Grid.Row="0" Grid.RowSpan="3"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    Margin="0,0,0,56" Padding="14,8"
                    Background="{StaticResource CardAltBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.5" Color="Black"/>
                </Border.Effect>
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Opacity" Value="0"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ToastVisible}" Value="False">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                              To="0" Duration="0:0:0.25"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                              To="1" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding ToastMessage}"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold"/>
            </Border>
        </Grid>
    </Border>
</Window>
