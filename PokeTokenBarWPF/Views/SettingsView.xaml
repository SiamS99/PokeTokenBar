<UserControl x:Class="PokeTokenBar.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,7"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>

        <!-- Tray display -->
        <TextBlock Text="Tray Display" Style="{StaticResource SectionHeader}" Margin="4,0,0,6"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show tokens" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding Store.Settings.ShowTokensInTray, Mode=TwoWay}"/>
                </Grid>

                <Border Height="1" Background="{StaticResource DividerBrush}"/>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show cost" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding Store.Settings.ShowCostInTray, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- General -->
        <TextBlock Text="General" Style="{StaticResource SectionHeader}" Margin="4,0,0,6"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid Style="{StaticResource Row}" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Launch at startup" Style="{StaticResource Lbl}"/>
                <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                          IsChecked="{Binding Store.Settings.LaunchAtStartup, Mode=TwoWay}"/>
            </Grid>
        </Border>

        <!-- Refresh -->
        <TextBlock Text="Refresh Interval" Style="{StaticResource SectionHeader}" Margin="4,0,0,6"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <Grid Style="{StaticResource Row}" Margin="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Every N minutes (0 = manual)" Style="{StaticResource Lbl}" TextWrapping="Wrap"/>
                <Border Grid.Column="1" Background="{StaticResource CardAltBrush}"
                        CornerRadius="6" Margin="8,0,0,0">
                    <TextBox Text="{Binding Store.Settings.RefreshIntervalMinutes,
                                        Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Foreground="{StaticResource TextBrush}"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{StaticResource AccentBrush}"
                             Padding="8,4"
                             TextAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- OhMyPosh -->
        <TextBlock Text="OhMyPosh Integration" Style="{StaticResource SectionHeader}" Margin="4,0,0,6"/>
        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
            <StackPanel>
                <Grid Style="{StaticResource Row}" Margin="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Export omp.json" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                              IsChecked="{Binding Store.Settings.OhMyPoshExportEnabled, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Foreground="{StaticResource SubtextBrush}"
                           FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0">
                    Writes %APPDATA%\PokeTokenBar\omp.json every refresh.
                    Use the 'command' segment in your OhMyPosh config to display it.
                </TextBlock>

                <Border Background="{StaticResource CardAltBrush}" CornerRadius="6" Padding="8,6" Margin="0,8,0,0">
                    <TextBlock FontFamily="Consolas" FontSize="9"
                               Foreground="{StaticResource SubtextBrush}"
                               TextWrapping="Wrap">
                        "command": "pwsh -nop -c &amp; { $d=(gc -Raw \"$env:APPDATA\PokeTokenBar\omp.json\"|ConvertFrom-Json); \"$($d.companion) $($d.tokens_today_fmt)\" }"
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Save button -->
        <Button HorizontalAlignment="Right" Margin="0,4,0,4"
                Click="Save_Click"
                Style="{StaticResource GhostButton}">
            Save Settings
        </Button>
    </StackPanel>
</UserControl>
