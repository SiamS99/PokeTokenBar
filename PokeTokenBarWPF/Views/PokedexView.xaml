<UserControl x:Class="PokeTokenBar.Views.PokedexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PokeTokenBar.Views">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush"    Color="#16213E"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#FFD700"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="📖 Pokédex"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,8"/>

        <TextBlock Text="{Binding Store.Companion.State.Dex.Count,
                             StringFormat='Caught: {0} species'}"
                   Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" Margin="0,0,0,8"/>

        <!-- Dex grid -->
        <ItemsControl ItemsSource="{Binding Store.Companion.State.Dex}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="#0F3460" CornerRadius="6"
                            Width="64" Height="72" Margin="4"
                            ToolTip="{Binding FinalId, StringFormat='#{0}'}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="28"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalId, StringFormat='#{0}'}"
                                       Foreground="{StaticResource SubtextBrush}"
                                       FontSize="9"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <TextBlock Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" TextAlignment="Center"
                   Margin="0,24,0,0"
                   Visibility="{Binding Store.Companion.State.Dex.Count,
                       Converter={x:Static views:ZeroToVisConverter.Instance}}">
            No Pokémon caught yet.{LineBreak}Keep coding to hatch your first egg!
        </TextBlock>
    </StackPanel>
</UserControl>
