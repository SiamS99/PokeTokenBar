<UserControl x:Class="PokeTokenBar.Views.SpriteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <!-- Egg / no sprite placeholder -->
        <TextBlock x:Name="EggEmoji" Text="🥚"
                   FontSize="40" HorizontalAlignment="Center"
                   VerticalAlignment="Center"/>

        <!-- Pokémon sprite (animated GIF or static PNG) -->
        <Image x:Name="SpriteImage"
               Stretch="Uniform"
               Width="72" Height="72"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Visibility="Collapsed"/>

        <!-- Loading indicator -->
        <ProgressBar x:Name="Spinner"
                     IsIndeterminate="True"
                     Width="40" Height="4"
                     VerticalAlignment="Bottom"
                     Visibility="Collapsed"/>
    </Grid>
</UserControl>
