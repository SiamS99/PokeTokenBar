<UserControl x:Class="PokeTokenBar.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="TextBrush"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#FFD700"/>
        <SolidColorBrush x:Key="CardBrush"    Color="#16213E"/>

        <Style x:Key="Row" TargetType="Grid">
            <Setter Property="Margin" Value="0,6"/>
        </Style>
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="Foreground"        Value="{StaticResource TextBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="⚙️ Settings"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Tray display -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Tray Display" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show tokens" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource Check}"
                              IsChecked="{Binding Store.Settings.ShowTokensInTray, Mode=TwoWay}"/>
                </Grid>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Show cost" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource Check}"
                              IsChecked="{Binding Store.Settings.ShowCostInTray, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- General -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="General" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Launch at startup" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource Check}"
                              IsChecked="{Binding Store.Settings.LaunchAtStartup, Mode=TwoWay}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Refresh -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="Refresh Interval" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Every N minutes (0 = manual)"
                               Style="{StaticResource Lbl}"/>
                    <TextBox Grid.Column="1" Margin="8,0,0,0"
                             Text="{Binding Store.Settings.RefreshIntervalMinutes,
                                            Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                             Foreground="{StaticResource TextBrush}"
                             Background="#0F3460"
                             BorderBrush="{StaticResource AccentBrush}"
                             Padding="4,2"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- OhMyPosh -->
        <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="OhMyPosh Integration" Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold" Margin="0,0,0,6"/>

                <Grid Style="{StaticResource Row}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Export omp.json" Style="{StaticResource Lbl}"/>
                    <CheckBox Grid.Column="1" Style="{StaticResource Check}"
                              IsChecked="{Binding Store.Settings.OhMyPoshExportEnabled, Mode=TwoWay}"/>
                </Grid>

                <TextBlock Foreground="{StaticResource SubtextBrush}"
                           FontSize="9" TextWrapping="Wrap" Margin="0,4,0,0">
                    Writes %APPDATA%\PokeTokenBar\omp.json every refresh.
                    Use the 'command' segment in your OhMyPosh config to display it.
                </TextBlock>

                <Border Background="#0F3460" CornerRadius="4" Padding="8,4" Margin="0,6,0,0">
                    <TextBlock FontFamily="Consolas" FontSize="9"
                               Foreground="{StaticResource SubtextBrush}"
                               TextWrapping="Wrap">
                        "command": "pwsh -nop -c &amp; { $d=(gc -Raw \"$env:APPDATA\PokeTokenBar\omp.json\"|ConvertFrom-Json); \"$($d.companion) $($d.tokens_today_fmt)\" }"
                    </TextBlock>
                </Border>
            </StackPanel>
        </Border>

        <!-- Save button -->
        <Button HorizontalAlignment="Right" Margin="0,8,0,0"
                Click="Save_Click"
                Background="#FFD700" Foreground="#1A1A2E"
                FontWeight="Bold" FontSize="11"
                Padding="16,6" Cursor="Hand"
                BorderThickness="0">
            Save Settings
        </Button>
    </StackPanel>
</UserControl>
