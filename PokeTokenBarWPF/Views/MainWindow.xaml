<Window x:Class="PokeTokenBar.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PokeTokenBar.ViewModels"
        xmlns:views="clr-namespace:PokeTokenBar.Views"
        Title="PokeTokenBar"
        Width="360" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <!-- Colours -->
        <SolidColorBrush x:Key="BgBrush"      Color="#1A1A2E"/>
        <SolidColorBrush x:Key="CardBrush"    Color="#16213E"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#FFD700"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="TabBrush"     Color="#0F3460"/>

        <!-- Tab button style -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{StaticResource SubtextBrush}"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="Padding"     Value="4,8"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card style -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background"     Value="{StaticResource CardBrush}"/>
            <Setter Property="CornerRadius"   Value="8"/>
            <Setter Property="Padding"        Value="12"/>
            <Setter Property="Margin"         Value="0,4"/>
        </Style>
    </Window.Resources>

    <!-- Outer border gives rounded corners + shadow -->
    <Border Background="{StaticResource BgBrush}"
            CornerRadius="12"
            Margin="8">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="*"/>     <!-- Content -->
                <RowDefinition Height="Auto"/>  <!-- Tab bar -->
            </Grid.RowDefinitions>

            <!-- ── Header ─────────────────────────────────────────────────── -->
            <Border Grid.Row="0"
                    Background="{StaticResource TabBrush}"
                    CornerRadius="12,12,0,0"
                    Padding="12,8">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🎮" FontSize="14" Margin="0,0,6,0"/>
                        <TextBlock Text="PokeTokenBar"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding RefreshCommand}"
                                Style="{StaticResource TabBtn}"
                                ToolTip="Refresh now"
                                FontSize="14" Padding="4">🔄</Button>
                        <Button Click="CloseButton_Click"
                                Style="{StaticResource TabBtn}"
                                FontSize="14" Padding="4,4,2,4">✕</Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Content area ───────────────────────────────────────────── -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" MaxHeight="520">
                <Grid Margin="12">

                    <!-- Home tab -->
                    <views:HomeView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Home}"
                        DataContext="{Binding}"/>

                    <!-- Pokedex tab -->
                    <views:PokedexView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Pokedex}"
                        DataContext="{Binding}"/>

                    <!-- Shop tab -->
                    <views:ShopView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Shop}"
                        DataContext="{Binding}"/>

                    <!-- Settings tab -->
                    <views:SettingsView Visibility="{Binding CurrentTab,
                        Converter={x:Static views:TabVisConverter.Instance},
                        ConverterParameter=Settings}"
                        DataContext="{Binding}"/>
                </Grid>
            </ScrollViewer>

            <!-- ── Tab bar ────────────────────────────────────────────────── -->
            <Border Grid.Row="2"
                    Background="{StaticResource TabBrush}"
                    CornerRadius="0,0,12,12">
                <UniformGrid Columns="4" Margin="4,0">
                    <Button Command="{Binding GoHomeCommand}"     Style="{StaticResource TabBtn}">🏠 Home</Button>
                    <Button Command="{Binding GoPokedexCommand}"  Style="{StaticResource TabBtn}">📖 Dex</Button>
                    <Button Command="{Binding GoShopCommand}"     Style="{StaticResource TabBtn}">🛍 Shop</Button>
                    <Button Command="{Binding GoSettingsCommand}" Style="{StaticResource TabBtn}">⚙️ Settings</Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>
