<UserControl x:Class="PokeTokenBar.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PokeTokenBar.Views"
             xmlns:core="clr-namespace:PokeTokenBar.Core">

    <StackPanel>

        <!-- ── Companion ──────────────────────────────────────────────────── -->
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="76"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sprite / egg display -->
            <Border Grid.Column="0"
                    Width="72" Height="72"
                    Background="{StaticResource CardBrush}"
                    CornerRadius="10">
                <views:SpriteView x:Name="SpriteCtrl" DataContext="{Binding}"/>
            </Border>

            <!-- Companion info -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CompanionName}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>

                    <!-- Rarity badge -->
                    <Border Margin="6,0,0,0" Padding="6,1" CornerRadius="6"
                            VerticalAlignment="Center"
                            Visibility="{Binding Store.Companion.State.Active,
                                Converter={x:Static views:NullToVisConverter.Instance}}"
                            Background="{Binding Store.Companion.State.Active.Rarity,
                                Converter={x:Static views:RarityToBrushConverter.Instance}}">
                        <TextBlock Text="{Binding Store.Companion.State.Active.Rarity}"
                                   FontSize="8" FontWeight="Bold" Foreground="White"/>
                    </Border>

                    <!-- Shiny sparkle -->
                    <TextBlock Text="✨" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Center"
                               Visibility="{Binding Store.Companion.State.Active.IsShiny,
                                   Converter={x:Static views:BoolToVisConverter.Instance}}"/>
                </StackPanel>

                <TextBlock Text="{Binding StageLabel}"
                           Foreground="{StaticResource SubtextBrush}"
                           FontSize="10" Margin="0,2,0,6"/>

                <!-- Progress bar (Grid star-columns — robust across WPF versions, unlike a
                     restyled ProgressBar template which risks a silently-broken fill). -->
                <Grid Height="5">
                    <Border Background="{StaticResource DividerBrush}" CornerRadius="3"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding EggProgressValue,
                                Converter={x:Static views:FractionToStarWidthConverter.Instance}}"/>
                            <ColumnDefinition Width="{Binding EggProgressValue,
                                Converter={x:Static views:FractionToStarWidthConverter.Instance}, ConverterParameter=invert}"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{StaticResource TextBrush}" CornerRadius="3"/>
                    </Grid>
                </Grid>

                <TextBlock Text="{Binding EggProgress, StringFormat='{}{0} to next stage'}"
                           Foreground="{StaticResource SubtextBrush}"
                           FontSize="9" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,0,0,12"/>

        <!-- ── Today's usage ─────────────────────────────────────────────── -->
        <TextBlock Text="Today's tokens" Style="{StaticResource SectionHeader}" Margin="0,0,0,2"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding TodayTokens}" Style="{StaticResource BigStatValue}"/>
            <TextBlock Grid.Column="1" Text="{Binding TodayCost}"
                       Foreground="{StaticResource SubtextBrush}" FontSize="12"
                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
        </Grid>

        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="This week" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="{Binding WeekTokens}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="This month" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="{Binding MonthTokens}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>

        <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,12"/>

        <!-- ── Burn rate + wallet ────────────────────────────────────────── -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Burn rate" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="{Binding BurnRate}" Style="{StaticResource StatValue}" Margin="0,2,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="Wallet" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="{Binding WalletDisplay}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0"/>
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
