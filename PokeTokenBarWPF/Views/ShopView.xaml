<UserControl x:Class="PokeTokenBar.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>

        <!-- Wallet -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Spendable tokens" Style="{StaticResource SectionHeader}"/>
                <TextBlock Text="{Binding WalletDisplay}" Style="{StaticResource BigStatValue}" Margin="0,2,0,2"/>
                <TextBlock Text="Spend the tokens you've used on items."
                           Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- Rare Candy -->
        <Border Style="{StaticResource Card}">
            <Grid>
                <StackPanel Margin="0,0,70,0">
                    <TextBlock Text="🍬 Rare Candy" Foreground="{StaticResource TextBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Instantly boosts your companion's progress by 100M tokens."
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,6"/>
                    <TextBlock Text="Cost 500M" Foreground="{StaticResource SubtextBrush}" FontSize="10"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource GhostButton}"
                        Command="{Binding UseRareCandyCommand}"
                        ToolTip="Use a Rare Candy">
                    Use
                </Button>
            </Grid>
        </Border>

        <!-- Bag inventory -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="Bag" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                <TextBlock Foreground="{StaticResource TextBrush}" FontSize="11" Margin="0,0,0,2">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Rare Candy ×{0}">
                            <Binding Path="Store.Companion.State.Inventory[rareCandy]"
                                     FallbackValue="0" TargetNullValue="0"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Foreground="{StaticResource TextBrush}" FontSize="11">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Mint ×{0}">
                            <Binding Path="Store.Companion.State.Inventory[mint]"
                                     FallbackValue="0" TargetNullValue="0"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
