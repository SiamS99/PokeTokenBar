<UserControl x:Class="PokeTokenBar.Views.ShopView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <SolidColorBrush x:Key="CardBrush"    Color="#16213E"/>
        <SolidColorBrush x:Key="TextBrush"    Color="#E8E8E8"/>
        <SolidColorBrush x:Key="SubtextBrush" Color="#9A9AB0"/>
        <SolidColorBrush x:Key="AccentBrush"  Color="#FFD700"/>

        <Style x:Key="ShopBtn" TargetType="Button">
            <Setter Property="Background"     Value="#0F3460"/>
            <Setter Property="Foreground"     Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"        Value="10,5"/>
            <Setter Property="Cursor"         Value="Hand"/>
            <Setter Property="FontSize"       Value="11"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="🛍 Shop"
                   Foreground="{StaticResource AccentBrush}"
                   FontSize="14" FontWeight="Bold" Margin="0,0,0,4"/>

        <!-- Wallet -->
        <Border Background="#16213E" CornerRadius="8" Padding="10,6" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="💰 Wallet: "
                           Foreground="{StaticResource SubtextBrush}" FontSize="11"/>
                <TextBlock Text="{Binding WalletDisplay}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="11" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

        <!-- Rare Candy -->
        <Border Background="#16213E" CornerRadius="8" Padding="12,8" Margin="0,4">
            <Grid>
                <StackPanel>
                    <TextBlock Text="🍬 Rare Candy" Foreground="{StaticResource TextBrush}"
                               FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Text="Instantly boost your companion's progress by 100M tokens."
                               Foreground="{StaticResource SubtextBrush}"
                               FontSize="10" TextWrapping="Wrap" Margin="0,2,0,4"/>
                    <TextBlock Text="Cost: 500M tokens" Foreground="{StaticResource AccentBrush}"
                               FontSize="10"/>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource ShopBtn}"
                        Command="{Binding UseRareCandyCommand}"
                        ToolTip="Use a Rare Candy">
                    Use
                </Button>
            </Grid>
        </Border>

        <!-- Bag inventory display -->
        <Border Background="#16213E" CornerRadius="8" Padding="12,8" Margin="0,4">
            <StackPanel>
                <TextBlock Text="🎒 Bag" Foreground="{StaticResource TextBrush}"
                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="10">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Rare Candy ×{0}">
                            <Binding Path="Store.Companion.State.Inventory[rareCandy]"
                                     FallbackValue="0" TargetNullValue="0"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock Foreground="{StaticResource SubtextBrush}" FontSize="10">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Mint ×{0}">
                            <Binding Path="Store.Companion.State.Inventory[mint]"
                                     FallbackValue="0" TargetNullValue="0"/>
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
