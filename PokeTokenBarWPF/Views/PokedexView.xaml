<UserControl x:Class="PokeTokenBar.Views.PokedexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:PokeTokenBar.Views">

    <StackPanel>
        <TextBlock Text="{Binding Store.Companion.State.Dex.Count,
                             StringFormat='Pokédex · {0} species'}"
                   Style="{StaticResource SectionHeader}"
                   FontSize="12" Margin="0,0,0,10"/>

        <!-- Dex grid -->
        <ItemsControl ItemsSource="{Binding Store.Companion.State.Dex}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" CornerRadius="8"
                            Width="66" Height="72" Margin="0,0,6,6"
                            ToolTip="{Binding FinalId, StringFormat='#{0}'}">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🎮" FontSize="26" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding FinalId, StringFormat='#{0}'}"
                                       Foreground="{StaticResource SubtextBrush}"
                                       FontSize="9" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Empty state -->
        <TextBlock Foreground="{StaticResource SubtextBrush}"
                   FontSize="11" TextAlignment="Center"
                   Margin="0,24,0,0"
                   Visibility="{Binding Store.Companion.State.Dex.Count,
                       Converter={x:Static views:ZeroToVisConverter.Instance}}">
            No Pokémon caught yet.{LineBreak}Keep coding to hatch your first egg!
        </TextBlock>
    </StackPanel>
</UserControl>
